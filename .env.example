# ============================================================
# Weizx 微信自动回复机器人 (macOS) - 环境变量配置
# 复制此文件为 .env 并填入实际值
# cp .env.example .env
# ============================================================

# ---------- 必填项 ----------

# DeepSeek API Key（或其他 AI provider 的 key，用于视觉定位）
DEEPSEEK_API_KEY=sk-your-key-here

# 微信消息数据库密钥（macOS 密钥自动提取失败时，在本机填写；64 位十六进制）
# macOS 通常从进程内存自动提取，无需手动填；只有当提取失败时才用此回退。
# WEIZX_WECHAT_DB_KEY=
# 联系人数据库使用不同密钥时，还需填写以下值才能安全匹配聊天标题
# WEIZX_WECHAT_CONTACT_DB_KEY=

# ---------- 安全配置（生产环境务必修改） ----------

# JWT 令牌签名密钥（请使用随机字符串）
JWT_SECRET=change-me-to-a-random-string

# 管理员密码
ADMIN_PASSWORD=admin123

# ---------- 可选配置 ----------

# 高德地图 API Key
AMAP_KEY=

# 高德地图安全密钥
AMAP_SECURITY_KEY=

# 自定义配置文件路径（默认 config/config.yaml）
# WEIZX_CONFIG=config/config.yaml

# ---------- macOS 权限备注 ----------
# 密钥提取需「辅助功能」+「屏幕录制」权限。
# 系统设置 → 隐私与安全性 → 辅助功能 / 屏幕录制，添加运行 weizx 的进程。
